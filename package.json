{
  "name": "kir-lint",
  "version": "1.0.0",
  "description": "A small, strict ESLint setup for our Convex + TypeScript + React apps. Every rule is there because it caught a real bug.",
  "type": "module",
  "license": "MIT",
  "author": "Kir",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Re11oy/kir-lint.git"
  },
  "keywords": [
    "eslint",
    "eslint-config",
    "convex",
    "react",
    "typescript"
  ],
  "exports": {
    ".": "./index.js",
    "./plugin": "./plugin.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "kir-lint": "./bin/kir-lint.js"
  },
  "files": [
    "index.js",
    "plugin.js",
    "rules",
    "bin",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "lint": "eslint . --max-warnings 0"
  },
  "peerDependencies": {
    "@convex-dev/eslint-plugin": "^5.0.1",
    "eslint": "^9.24.0 || ^10.0.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "typescript": "^5.8.0 || ^6.0.0",
    "typescript-eslint": "^8.73.0"
  },
  "peerDependenciesMeta": {
    "@convex-dev/eslint-plugin": {
      "optional": true
    },
    "eslint-plugin-react-hooks": {
      "optional": true
    }
  },
  "dependencies": {
    "@eslint-community/eslint-plugin-eslint-comments": "^4.8.1"
  },
  "devDependencies": {
    "@convex-dev/eslint-plugin": "^5.0.1",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0"
  }
}
